      "esbuild": "0.25.0",
      "uuid": "^11.1.1",
      "form-data": "^4.0.6",
      "axios": "^1.21.1",
      "follow-redirects": "^1.16.3",
      "js-yaml": "^4.3.2",
      "brace-expansion": "^2.1.8",
      "@babel/core": "^7.29.6",
      "postcss": "^8.5.33",
      "nanoid": "^3.3.20",
      "postcss-selector-parser": "^6.1.6",
      "browserslist": "^4.29.6",
      "baseline-browser-mapping": "^2.11.39",
      "source-map-js": "^1.2.4"
    }
